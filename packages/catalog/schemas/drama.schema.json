{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "903 Player 廣播劇（drama.json）",
    "description": "一個 folder = 一套廣播劇（apps/player/src/catalog/dramas/library/<id>/drama.json）。runtime 驗證喺 packages/catalog/src/dramas/schema.ts；以下幾樣 JSON Schema 表達唔到，淨係 runtime 驗：圖檔要真係喺 folder 入面、folder 名要係細楷英數同連字號、arc name / id 唔可以重複、每日劇 date 唔可以重複、titles / files / episodeDates / episodeRemovedAt 嘅集數要喺 firstNo 至最後一集之內、上架 / 下架日嘅先後（下架遲過上架；arc 下架唔可以遲過劇集、集數下架唔可以遲過 arc；episodeDates 跟集數遞增、遲過 arc addedAt）、episodeRemovedAt 範圍唔可以重疊。",
    "type": "object",
    "required": ["name", "kind", "enabled", "tile", "disc", "audio", "theme"],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "指去呢份 JSON Schema（editor 用，app 唔理）"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "劇集名（顯示用）"
        },
        "kind": {
            "enum": ["series", "daily"],
            "description": "series = 短篇劇集（要寫 arcs）；daily = 每日劇集（要寫 episodes）"
        },
        "enabled": {
            "type": "boolean",
            "description": "false = 暫時停用：主頁唔出、劇集頁當搵唔到"
        },
        "order": {
            "type": "integer",
            "description": "主頁次序（細嘅排先）；冇寫就排喺有寫嘅後面，按 id 排"
        },
        "arcUnit": {
            "enum": ["season"],
            "description": "（optional）短篇單位叫「季」（例如主頁角落「全 4 季」）；唔寫 = 短篇"
        },
        "tile": {
            "type": "string",
            "minLength": 1,
            "description": "主頁劇集格圖：folder 內檔名（2:1，1216×608 webp）"
        },
        "disc": {
            "type": "string",
            "minLength": 1,
            "description": "劇集碟面圖：folder 內檔名（正方形 webp）"
        },
        "audio": {
            "type": "object",
            "description": "錄音位置（只用嚟播放；進度 / 收藏 key 係 episode ID，唔係網址）",
            "required": ["host", "folder", "file"],
            "additionalProperties": false,
            "properties": {
                "host": {
                    "enum": ["r2", "app"],
                    "description": "r2 = Cloudflare R2（DRAMA_AUDIO_BASE）；app = app 自己 host（BASE_URL/dramas/）"
                },
                "folder": {
                    "type": "string",
                    "minLength": 1,
                    "description": "host 上面嘅劇集 folder"
                },
                "file": {
                    "type": "string",
                    "minLength": 1,
                    "description": "檔名 template。series 用 {no} {no2} {noZh}（中文數字）{arc} {folder} {title}；daily 用 {date} {yyyymmdd} {folder}。[ … ] 入面 token 空值就整段略去，例如 \"{no2} - {arc} - 第{noZh}集[ - {title}].m4a\""
                }
            }
        },
        "theme": { "$ref": "#/definitions/theme" },
        "summary": {
            "$ref": "#/definitions/summary",
            "description": "（optional）劇集簡介，1–500 字"
        },
        "addedAt": {
            "$ref": "#/definitions/date",
            "description": "（optional）全劇上架日 YYYY-MM-DD（香港時間當日 00:00 起）：將來日子 = 整套即將上架（主頁書架最尾灰格、劇集頁打唔開）；短篇劇亦係短篇預設上架日（arc 自己有就用 arc 嘅）。14 日內出「新」"
        },
        "removedAt": {
            "$ref": "#/definitions/date",
            "description": "（optional）全劇下架日 YYYY-MM-DD：香港時間當日 00:00 起唔再提供（前 30 日出「快將下架」）；要遲過 addedAt"
        },
        "arcs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/arc" },
            "description": "（series 必填）短篇 / 季 list，照播放次序；name 同 id 都唔可以重複"
        },
        "episodes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/dailyEpisode" },
            "description": "（daily 必填）每日集數 list；date 唔可以重複"
        }
    },
    "allOf": [
        {
            "if": {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "series" } }
            },
            "then": {
                "type": "object",
                "required": ["arcs"],
                "properties": {
                    "episodes": false,
                    "audio": {
                        "type": "object",
                        "properties": {
                            "file": {
                                "type": "string",
                                "pattern": "^(?:[^{]|\\{(?:no|no2|noZh|arc|folder|title)\\}|\\{(?!\\w+\\}))*$",
                                "description": "series 檔名 template：只可以用 {no} {no2} {noZh} {arc} {folder} {title}"
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "daily" } }
            },
            "then": {
                "type": "object",
                "required": ["episodes"],
                "properties": {
                    "arcs": false,
                    "audio": {
                        "type": "object",
                        "properties": {
                            "file": {
                                "type": "string",
                                "pattern": "^(?:[^{]|\\{(?:date|yyyymmdd|folder)\\}|\\{(?!\\w+\\}))*$",
                                "description": "daily 檔名 template：只可以用 {date} {yyyymmdd} {folder}"
                            }
                        }
                    }
                }
            }
        }
    ],
    "definitions": {
        "date": {
            "type": "string",
            "pattern": "^(?:0[1-9][0-9]{2}|[1-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$",
            "format": "date",
            "description": "YYYY-MM-DD，要係真實存在嘅日子（例如唔可以 2026-02-30）"
        },
        "episodeNumberMap": {
            "type": "object",
            "propertyNames": { "pattern": "^(?:0|[1-9][0-9]*)$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "arc": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": false,
            "if": { "not": { "required": ["episodes"] } },
            "then": {
                "required": ["addedAt"],
                "not": {
                    "anyOf": [
                        { "required": ["titles"] },
                        { "required": ["files"] },
                        { "required": ["episodeDates"] },
                        { "required": ["episodeRemovedAt"] }
                    ]
                }
            },
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "短篇 ID：細楷英文 / 數字 slug（例如 season-1），用嚟砌 episode ID（進度 / 收藏 key：drama:<劇 id>:<短篇 id>:<集數>）。有圖嘅短篇沿用圖片 folder 名（arcs/<slug>/）；同一劇唔可以重複；⚠️ 發佈咗就唔可以改，否則已儲進度冇晒"
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "短篇名（= R2 folder 名，亦係 template 嘅 {arc}）；唔可以重複。改名唔影響進度（進度用 id）"
                },
                "episodes": {
                    "description": "集數（正整數），或者集名 list（冇集名寫 null）。未上架嘅短篇未知集數可以唔寫，但一定要有 addedAt（runtime 亦接受用劇集層 addedAt）；到期仍未補就繼續當未上架",
                    "anyOf": [
                        { "type": "integer", "minimum": 1 },
                        { "type": "array", "minItems": 1, "items": { "type": ["string", "null"] } }
                    ]
                },
                "firstNo": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 1,
                    "description": "第一集集數；唔寫 = 1，有第零集寫 0"
                },
                "titles": {
                    "$ref": "#/definitions/episodeNumberMap",
                    "description": "{ \"集數\": \"集名\" } 零散補集名；集數要喺呢個短篇範圍之內"
                },
                "files": {
                    "$ref": "#/definitions/episodeNumberMap",
                    "description": "{ \"集數\": \"完整檔名\" } 不規則檔名；集數要喺呢個短篇範圍之內"
                },
                "addedAt": {
                    "$ref": "#/definitions/date",
                    "description": "（optional）短篇上架日 YYYY-MM-DD（香港時間當日 00:00 起），將來日子 = 即將上架；14 日內出「新」；冇就用全劇 addedAt"
                },
                "removedAt": {
                    "$ref": "#/definitions/date",
                    "description": "（optional）短篇下架日 YYYY-MM-DD；要遲過 addedAt、唔可以遲過全劇 removedAt"
                },
                "episodeDates": {
                    "type": "object",
                    "propertyNames": { "pattern": "^(?:0|[1-9][0-9]*)$" },
                    "additionalProperties": { "$ref": "#/definitions/date" },
                    "description": "（optional）逐集上架：{ \"集數\": \"YYYY-MM-DD\" } = 呢集起嘅上架日（第一批跟 addedAt）；日子跟集數遞增、遲過 addedAt。新一批上架出 14 日「新」"
                },
                "episodeRemovedAt": {
                    "type": "object",
                    "propertyNames": { "pattern": "^(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*))?$" },
                    "additionalProperties": { "$ref": "#/definitions/date" },
                    "description": "（optional）集數下架：{ \"3\": 日子 } 單集或者 { \"1-5\": 日子 } 範圍；範圍唔可以重疊、唔可以遲過短篇 removedAt"
                },
                "disc": {
                    "type": "string",
                    "minLength": 1,
                    "description": "（optional）短篇自己嘅碟面圖：folder 內相對 path，慣例 arcs/<slug>/disc.webp；冇就用劇集碟面"
                },
                "tile": {
                    "type": "string",
                    "minLength": 1,
                    "description": "（optional）短篇長方形圖：folder 內相對 path，慣例 arcs/<slug>/tile.webp（16:9，1216×684）；暫時未用，留底防將來要"
                },
                "enabled": {
                    "type": "boolean",
                    "description": "（optional）false = 下架：player 唔顯示呢個短篇；唔寫 = 上架。admin 掃描到嘅新短篇預設 false（排咗期先上架）"
                },
                "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "description": "（optional）player 顯示嘅短篇名（1–40 字）；唔寫就用 name。name 繼續係 R2 子資料夾名，唔好改"
                },
                "summary": {
                    "$ref": "#/definitions/summary",
                    "description": "（optional）短篇簡介，1–500 字"
                },
                "cast": {
                    "$ref": "#/definitions/names",
                    "description": "（optional）聲演：最多 12 個，每個 1–40 字"
                }
            }
        },
        "dailyEpisode": {
            "type": "object",
            "required": ["date"],
            "additionalProperties": false,
            "properties": {
                "date": {
                    "$ref": "#/definitions/date",
                    "description": "播出日 YYYY-MM-DD；唔可以重複"
                },
                "rerun": {
                    "type": "boolean",
                    "default": false,
                    "description": "true = 重播舊集（標「重溫」）"
                },
                "file": {
                    "type": "string",
                    "minLength": 1,
                    "description": "（optional）完整檔名，蓋過 audio.file template"
                }
            }
        },
        "hexColour": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "format": "color-hex",
            "description": "#rrggbb 色（六位 hex，大細楷都得）"
        },
        "nonEmptyString": { "type": "string", "minLength": 1 },
        "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "簡介：1–500 字（P9.5 預備，player 暫時唔顯示）"
        },
        "names": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 },
            "description": "名單：最多 12 個，每個 1–40 字，唔可以重複（P9.5 預備，player 暫時唔顯示）"
        },
        "theme": {
            "type": "object",
            "description": "色調：10 隻必填色（#rrggbb）+ optional 嘅 statusBar / accentText / titleFont / headerRule / scheme",
            "required": [
                "bg",
                "surface",
                "track",
                "accent",
                "onAccent",
                "title",
                "text",
                "muted",
                "shadowDark",
                "shadowLight"
            ],
            "additionalProperties": false,
            "properties": {
                "bg": { "$ref": "#/definitions/hexColour", "description": "頁面底色" },
                "surface": { "$ref": "#/definitions/hexColour", "description": "卡 / 掣嘅面色" },
                "track": { "$ref": "#/definitions/hexColour", "description": "進度條路軌色" },
                "accent": {
                    "$ref": "#/definitions/hexColour",
                    "description": "主色（播放掣、進度）"
                },
                "onAccent": {
                    "$ref": "#/definitions/hexColour",
                    "description": "主色上面嘅字 / icon 色"
                },
                "title": { "$ref": "#/definitions/hexColour", "description": "標題字色" },
                "text": { "$ref": "#/definitions/hexColour", "description": "內文字色" },
                "muted": { "$ref": "#/definitions/hexColour", "description": "次要字色" },
                "shadowDark": {
                    "$ref": "#/definitions/hexColour",
                    "description": "立體陰影（暗邊）"
                },
                "shadowLight": {
                    "$ref": "#/definitions/hexColour",
                    "description": "立體陰影（光邊）"
                },
                "statusBar": {
                    "$ref": "#/definitions/hexColour",
                    "description": "（optional，淺色主題先要）iOS 狀態列色帶 / Android theme-color，墊住白字"
                },
                "accentText": {
                    "$ref": "#/definitions/hexColour",
                    "description": "（optional）強調色做文字（播緊嗰集、現正播放標籤）；淺色底 accent 唔夠對比先另外設，冇就用 accent"
                },
                "titleFont": {
                    "type": "string",
                    "pattern": "^[\\p{L}\\p{N}\\s'\",-]+$",
                    "description": "（optional）頁頭標題字體（CSS font-family）：淨係字體名、引號、逗號、連字號；冇就跟 app 字體"
                },
                "headerRule": {
                    "type": "string",
                    "pattern": "^(?!.*//)(?:(?:repeating-linear-gradient|linear-gradient|radial-gradient|calc)\\(|[a-z]+(?:-[a-z]+)*(?![a-z(-])|#[0-9a-fA-F]{3,8}(?![0-9a-zA-Z])|-?(?:[0-9]+\\.?[0-9]*|\\.[0-9]+)(?:%|px|em|rem|deg|turn|vw|vh|ch)?(?![0-9a-zA-Z(])|[(),/+*\\s-])+$",
                    "description": "（optional）頁頭底部裝飾線（CSS background）：淨係 linear / repeating-linear / radial-gradient、calc、hex 色、數字單位同關鍵字，唔准 url()、引號、escape（W-702，runtime 同一條 pattern）；冇就冇"
                },
                "scheme": {
                    "enum": ["light"],
                    "description": "（optional）淺色底（廣播劇）寫 \"light\"；唔寫 = 深色（全部 903 節目）"
                }
            }
        }
    }
}
