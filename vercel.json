{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "installCommand": "npm ci",
    "buildCommand": "npm run build -w apps/player",
    "outputDirectory": "apps/player/dist",
    "git": {
        "deploymentEnabled": {
            "claude/**": false,
            "feature/**": false,
            "fix/**": false,
            "hotfix/**": false,
            "refactor/**": false,
            "chore/**": false,
            "test/**": false,
            "docs/**": false,
            "worktree-*": false
        }
    }
}
