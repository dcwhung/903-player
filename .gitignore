node_modules
dist/
coverage/
*.log
.DS_Store
.env*
apps/*/e2e/screenshots/
# Python 工具（apps/player/scripts/arcCover）喺 repo 根跑 pytest / ruff 會留低 cache；prettier 跟 root .gitignore
__pycache__/
.pytest_cache/
.ruff_cache/
# 封面 review 頁（apps/player/scripts/arcCover/review）：生成物預設寫去 repo 外嘅 work 資料夾；
# 萬一 --work 指咗 repo 根 / apps/player / review 資料夾，淨係擋 build / generate / fetch 嘅確實輸出（大 binary、rounds / files / publish json）
/arcCover/*/*/round-*/
/arcCover-src/*/*.png
/arcCover-src/*/*.jpg
/review/site/
/review/files.json
/review/publish-*.json
/apps/player/arcCover/*/*/round-*/
/apps/player/arcCover-src/*/*.png
/apps/player/arcCover-src/*/*.jpg
/apps/player/review/site/
/apps/player/review/files.json
/apps/player/review/publish-*.json
apps/player/scripts/arcCover/review/**/site/
apps/player/scripts/arcCover/review/**/rounds.json
apps/player/scripts/arcCover/review/**/files.json
apps/player/scripts/arcCover/review/**/publish-*.json
apps/player/scripts/arcCover/review/**/*.png
apps/player/scripts/arcCover/review/**/*.jpg
apps/player/scripts/arcCover/review/**/*.webp

# agent worktrees (Claude Code isolation)
.claude/worktrees/
# apps/api（Cloudflare Worker）：本機 secret、wrangler / miniflare state、import 生成物
.dev.vars
.wrangler/
apps/api/.import/
# player prebuild snapshot（apps/player/scripts/catalogSnapshot.ts）：每次 production build 由最新 publish 生成
apps/player/src/catalog/snapshot/data/
apps/player/src/catalog/snapshot/data.tmp/
