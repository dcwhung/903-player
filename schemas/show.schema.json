{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "903 Player 節目（show.json）",
    "description": "一個 folder = 一個 903 節目（src/shows/<id>/show.json）。runtime 驗證喺 src/shows/schema.ts；圖檔要真係喺 folder 入面、folder 名要係細楷英數同連字號，呢兩樣淨係 runtime 驗。",
    "type": "object",
    "required": ["name", "fileTime", "airDays", "tile", "disc", "theme"],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "指去呢份 JSON Schema（editor 用，app 唔理）"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "原站 `?show=` 參數，亦係顯示名稱。⚠️ 用嚟砌錄音網址（= 已儲進度嘅 key），唔可以亂改"
        },
        "fileTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3])[0-5][0-9]$",
            "description": "原站錄音檔名嘅 HHMM（24 小時制，例如 \"1009\"）。⚠️ 用嚟砌錄音網址，唔可以亂改"
        },
        "airDays": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6,
                "description": "星期幾：0 = 星期日 … 6 = 星期六"
            },
            "description": "逢星期幾播（0 = 星期日 … 6 = 星期六），唔可以空、唔可以重複"
        },
        "order": {
            "type": "integer",
            "description": "主頁次序（細嘅排先）；冇寫就排喺有寫嘅後面，按 id 排"
        },
        "tile": {
            "type": "string",
            "minLength": 1,
            "description": "主頁節目格圖：folder 內檔名（16:9，1216×684 webp）"
        },
        "disc": {
            "type": "string",
            "minLength": 1,
            "description": "碟面圖：folder 內檔名（正方形，600×600 webp）"
        },
        "theme": { "$ref": "#/definitions/theme" }
    },
    "definitions": {
        "hexColour": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "format": "color-hex",
            "description": "#rrggbb 色（六位 hex，大細楷都得）"
        },
        "nonEmptyString": { "type": "string", "minLength": 1 },
        "theme": {
            "type": "object",
            "description": "色調：10 隻必填色（#rrggbb）+ optional 嘅 statusBar / accentText / titleFont / headerRule / scheme",
            "required": [
                "bg",
                "surface",
                "track",
                "accent",
                "onAccent",
                "title",
                "text",
                "muted",
                "shadowDark",
                "shadowLight"
            ],
            "additionalProperties": false,
            "properties": {
                "bg": { "$ref": "#/definitions/hexColour", "description": "頁面底色" },
                "surface": { "$ref": "#/definitions/hexColour", "description": "卡 / 掣嘅面色" },
                "track": { "$ref": "#/definitions/hexColour", "description": "進度條路軌色" },
                "accent": {
                    "$ref": "#/definitions/hexColour",
                    "description": "主色（播放掣、進度）"
                },
                "onAccent": {
                    "$ref": "#/definitions/hexColour",
                    "description": "主色上面嘅字 / icon 色"
                },
                "title": { "$ref": "#/definitions/hexColour", "description": "標題字色" },
                "text": { "$ref": "#/definitions/hexColour", "description": "內文字色" },
                "muted": { "$ref": "#/definitions/hexColour", "description": "次要字色" },
                "shadowDark": {
                    "$ref": "#/definitions/hexColour",
                    "description": "立體陰影（暗邊）"
                },
                "shadowLight": {
                    "$ref": "#/definitions/hexColour",
                    "description": "立體陰影（光邊）"
                },
                "statusBar": {
                    "$ref": "#/definitions/hexColour",
                    "description": "（optional，淺色主題先要）iOS 狀態列色帶 / Android theme-color，墊住白字"
                },
                "accentText": {
                    "$ref": "#/definitions/hexColour",
                    "description": "（optional）強調色做文字（播緊嗰集、現正播放標籤）；淺色底 accent 唔夠對比先另外設，冇就用 accent"
                },
                "titleFont": {
                    "$ref": "#/definitions/nonEmptyString",
                    "description": "（optional）頁頭標題字體（CSS font-family）；冇就跟 app 字體"
                },
                "headerRule": {
                    "$ref": "#/definitions/nonEmptyString",
                    "description": "（optional）頁頭底部裝飾線（CSS background）；冇就冇"
                },
                "scheme": {
                    "enum": ["light"],
                    "description": "（optional）淺色底（廣播劇）寫 \"light\"；唔寫 = 深色（全部 903 節目）"
                }
            }
        }
    }
}
